{
  "name": "embater",
  "version": "0.1.0",
  "private": true,
  "description": "Draw Greek temples from Vitruvius's own rules, check them against measured buildings, and learn the Greek, Latin and native names of every part.",
  "type": "module",
  "author": "Anthony Mercer <anthony@praviel.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonsoo/embater.git"
  },
  "homepage": "https://antonsoo.github.io/embater/",
  "keywords": [
    "ancient-greek",
    "latin",
    "vitruvius",
    "architecture",
    "classical-orders",
    "vocabulary",
    "education",
    "svg"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4412 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4412 --strictPort",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "data:build": "python3 scripts/build_temples.py && biome format --write src/data/temples.ts",
    "data:fetch": "python3 scripts/perseus_fetch.py",
    "test:plans": "node scripts/plan-review.mjs",
    "test:doorways": "node scripts/doorway-review.mjs",
    "test:doorway-recovery": "node scripts/doorway-recovery.mjs",
    "verify:doorway-artifacts": "python3 scripts/doorway-artifacts.py",
    "test:drill": "node --import tsx scripts/drill-review.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
